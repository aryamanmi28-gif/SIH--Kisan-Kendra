# Base URL of the Django REST API.
# Local development with the Vite proxy: VITE_API_BASE_URL=/api
# Direct: VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=/api

# Serve every screen from the in-browser mock backend.
# Set to "false" once the Django endpoints in src/api/endpoints.js are live.
VITE_USE_MOCK_API=true
