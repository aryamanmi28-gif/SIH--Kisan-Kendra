DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Leave all of the below empty/unset for local dev -- every one has a safe
# local default baked into settings.py. Set them on Railway for production.

# A long random string in production. Falls back to the checked-in
# development key if unset.
SECRET_KEY=

# Set to False on Railway. Defaults to True locally.
DEBUG=

# Comma-separated. Defaults to localhost,127.0.0.1. Set to your Railway
# domain (e.g. your-app.up.railway.app) in production.
ALLOWED_HOSTS=

# Comma-separated, no trailing slashes. Defaults to the local Vite dev
# origins. Set to your deployed Vercel origin (e.g. https://your-app.vercel.app)
# in production.
CORS_ALLOWED_ORIGINS=

# Comma-separated, full origins including scheme (e.g.
# https://your-app.up.railway.app). Needed for Django admin over https.
# Defaults to empty, which is fine locally (plain http).
CSRF_TRUSTED_ORIGINS=
